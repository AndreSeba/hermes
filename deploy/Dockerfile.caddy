# Caddy (HTTPS automático con Let's Encrypt) + el panel ya compilado (Hermes.Web, el repo hermano).
# Contexto: la carpeta que contiene los DOS repos (Hermes y Hermes.Web), por eso docker-compose usa `context: ../..`.

FROM node:24-alpine AS panel
WORKDIR /web
RUN corepack enable
COPY Hermes.Web/package.json Hermes.Web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY Hermes.Web/ ./
# El panel llama a /api en el MISMO dominio (Caddy lo pasa a la API): sin CORS y sin otra dirección que configurar.
ENV VITE_API_URL=""
# La dirección pública de las tiendas (la del enlace y el QR que ve la dueña): se fija al compilar, desde DOMINIO_TIENDA.
ARG TIENDA_URL
ENV VITE_TIENDA_URL=$TIENDA_URL
RUN pnpm build && mv dist dist-panel
# Ambiente de demostración (opcional): el mismo panel, pero con la dirección de SUS tiendas (deploy/docker-compose.demo.yml).
ARG TIENDA_URL_DEMO=""
RUN mkdir dist-demo && if [ -n "$TIENDA_URL_DEMO" ]; then VITE_TIENDA_URL="$TIENDA_URL_DEMO" pnpm build && rm -rf dist-demo && mv dist dist-demo; fi

FROM caddy:2-alpine
COPY Hermes/deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=panel /web/dist-panel /srv/panel
COPY --from=panel /web/dist-demo /srv/panel-demo
