# Copiar a .env (que NO se sube a git) y completar. Nunca poner estos valores en appsettings.json.

# Dominios (registro A apuntando a la IP del servidor). Ejemplo: panel.midominio.com y tienda.midominio.com
DOMINIO_PANEL=
DOMINIO_TIENDA=
# Para los avisos de Let's Encrypt (vencimiento de certificados).
EMAIL_CERTIFICADOS=

# Contraseñas de Postgres (largas y al azar, SOLO letras y números). Generar cada una con: openssl rand -hex 32
#   POSTGRES_PASSWORD: el dueño de las tablas (migraciones y respaldos).
#   APP_DB_PASSWORD:   el rol con el que entra la app (hermes_app, sin privilegios: le aplica la Row Level Security).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Clave para firmar las sesiones (mínimo 32 caracteres, mejor 64). Generar con: openssl rand -base64 48
# Cambiarla cierra todas las sesiones abiertas.
JWT_SECRET=

# Opcional: errores a Sentry (https://sentry.io). Vacío = sin Sentry.
SENTRY_DSN=

# Cómo pagar un plan (se muestra al pedirlo): datos REALES de la cuenta o del QR.
INSTRUCCIONES_DE_PAGO=

# Opcional: conexión con Instagram (M12). Los dos primeros salen de la app de Meta (Instagram > configuración de la API
# con inicio de sesión de Instagram); la clave se genera con: openssl rand -base64 32 (cambiarla obliga a reconectar).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CLAVE_CIFRADO=

# Cuántos días de respaldos diarios se guardan.
DIAS_RESPALDO=14
