@using Hermes.Public
@{
    // Lo pone cada página (ver TiendaBase). Sin tienda (404 / error) se usa una página neutra.
    var tienda = ViewData["Tienda"] as TiendaPublicaDto;
    var paleta = Tema.DeFondo(tienda?.Fondo ?? Hermes.Domain.Enums.FondoTienda.Crema);
    var marca = tienda?.Color ?? "#F2A33A";
    var titulo = ViewData["Titulo"] as string ?? tienda?.Nombre ?? "Tienda";
    var descripcion = ViewData["Descripcion"] as string;
    var imagen = ViewData["Imagen"] as string;
    var direccion = ViewData["Direccion"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@titulo</title>
    @if (!string.IsNullOrEmpty(descripcion))
    {
        <meta name="description" content="@descripcion" />
    }
    @* Vista previa al compartir el enlace (WhatsApp, Facebook, Telegram…): por eso la página se arma en el servidor. *@
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@titulo" />
    @if (!string.IsNullOrEmpty(descripcion))
    {
        <meta property="og:description" content="@descripcion" />
    }
    @if (!string.IsNullOrEmpty(imagen))
    {
        <meta property="og:image" content="@imagen" />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    @if (!string.IsNullOrEmpty(direccion))
    {
        <meta property="og:url" content="@direccion" />
        <link rel="canonical" href="@direccion" />
    }
    <meta name="theme-color" content="@marca" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=DM+Sans:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="/css/publico.css" asp-append-version="true" />
    <style>
        :root {
            --marca: @marca;
            --sobre-marca: @Tema.TextoSobre(marca);
            --fondo: @paleta.Fondo;
            --superficie: @paleta.Superficie;
            --texto: @paleta.Texto;
            --suave: @paleta.Suave;
            --borde: @paleta.Borde;
        }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
